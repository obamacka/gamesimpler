; Engine configuration file.
; Hand-maintained keys are verified against the Godot 4.7 ProjectSettings class reference.

config_version=5

[application]

config/name="Gamesimpler"
config/description="3D cozy mining, farming and crafting adventure"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="pet"
3d_physics/layer_5="interactables"
3d_physics/layer_6="tool_zones"
3d_physics/layer_7="build_pieces"
3d_physics/layer_8="pickups"
3d_physics/layer_9="safety"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
