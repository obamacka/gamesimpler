; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gamesimpler"
config/description="3D cozy mining, farming and crafting adventure"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
Database="*res://scripts/autoload/database.gd"
Settings="*res://scripts/autoload/settings.gd"
InputService="*res://scripts/autoload/input_service.gd"
PauseManager="*res://scripts/autoload/pause_manager.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
SaveService="*res://scripts/autoload/save_service.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

